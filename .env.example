PATHYA_ENV=dev
PATHYA_DATA_DIR=./data
# PATHYA_DB_PATH=./data/pathya.sqlite3
AUTH_MODE=local
# Required for session mode: generate a random secret of at least 32 characters.
SESSION_SECRET=
MAX_UPLOAD_MB=25
MAX_PAGES=60
MAX_PIXELS=40000000
MAX_JSON_BODY_BYTES=262144
REQUEST_RATE_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=30
QUESTION_RATE_LIMIT=60
DAILY_QUESTION_LIMIT=20
CORRECTION_RATE_LIMIT=120
MAX_CONCURRENT_UPLOADS=2
DAILY_PAGE_QUOTA=120
JOB_TIMEOUT_SECONDS=300
JOB_MAX_ATTEMPTS=3
RETENTION_DAYS_AFTER_END=30
DELETION_SLA_DAYS=7
RETENTION_EXTENSION_MAX_DAYS=365
BACKUP_DAYS=30
BACKUP_DIR=./backups
LLM_ENABLED=false
LLM_PROVIDER=none
LLM_MODEL_ID=
GEMINI_API_KEY=
LLM_MAX_INPUT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_PRICES_PATH=config/prices.json
LLM_PRICE_MAX_AGE_DAYS=30
API_BUDGET_INR_HARD_CAP=0
DOCUMENT_BUDGET_INR_HARD_CAP=0
QUESTION_MAX_CHARS=2000
ANSWER_NO_EVIDENCE_THRESHOLD=0
ANSWER_LOW_SUPPORT_THRESHOLD=0.1
EMBEDDINGS_ENABLED=false
# EMBEDDING_MODEL_PATH=
CORS_ORIGINS=["http://localhost:5173"]
STORAGE_MIN_FREE_BYTES=100000000

EXTRACTION_ADAPTER=fixture
P1_MAX_OUTPUT_BYTES=10000000
EXTRACTION_FIXTURE_PATH=tests/fixtures/chapter_demo.json
EXTRACTION_COMMAND=[]
JOB_LEASE_SECONDS=30

SPEECH_PROVIDER=disabled
SPEECH_VOICE=default
SPEECH_ENGINE_VERSION=
# Set to pathya to use the reader-compatible English/Hindi sentence rules.
SEGMENTER=
SEGMENTER_VERSION=demo-regex-v1
MAX_AUDIO_CLIP_MB=10
PACKAGE_MAX_MB=50

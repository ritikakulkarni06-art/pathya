            "type": "string"
          },
          "languages": {
            "default": "en,hi",
            "maxLength": 16,
            "title": "Languages",
            "type": "string"
          },
          "rights_note": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rights Note"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "file",
          "title"
        ],
        "title": "Body_upload_document_documents_post",
        "type": "object"
      },
      "CorrectionRequest": {
        "additionalProperties": false,
        "properties": {
          "base_revision": {
            "minimum": 1.0,
            "title": "Base Revision",
            "type": "integer"
          },
          "operations": {
            "items": {
              "discriminator": {
                "mapping": {
                  "mark_reviewed": "#/components/schemas/MarkReviewed",
                  "merge": "#/components/schemas/Merge",
                  "reorder": "#/components/schemas/Reorder",
                  "replace_text": "#/components/schemas/ReplaceText",
                  "set_alt_text": "#/components/schemas/SetAltText",
                  "set_language": "#/components/schemas/SetLanguage",
                  "set_mathml": "#/components/schemas/SetMathML",
                  "set_table_headers": "#/components/schemas/SetTableHeaders",
                  "set_type": "#/components/schemas/SetType",
                  "split": "#/components/schemas/Split"
                },
                "propertyName": "op"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ReplaceText"
                },
                {
                  "$ref": "#/components/schemas/SetLanguage"
                },
                {
                  "$ref": "#/components/schemas/SetType"
                },
                {
                  "$ref": "#/components/schemas/Reorder"
                },
                {
                  "$ref": "#/components/schemas/Split"
                },
                {
                  "$ref": "#/components/schemas/Merge"
                },
                {
                  "$ref": "#/components/schemas/MarkReviewed"
                },
                {
                  "$ref": "#/components/schemas/SetAltText"
                },
                {
                  "$ref": "#/components/schemas/SetMathML"
                },
                {
                  "$ref": "#/components/schemas/SetTableHeaders"
                }
              ]
            },
            "maxItems": 30,
            "minItems": 1,
            "title": "Operations",
            "type": "array"
          },
          "reason": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "base_revision",
          "operations",
          "reason"
        ],
        "title": "CorrectionRequest",
        "type": "object"
      },
      "Credentials": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"

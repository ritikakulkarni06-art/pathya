            "type": "string"
          },
          "parent_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_-]{1,128}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          }
        },
        "required": [
          "op",
          "parent_id"
        ],
        "title": "Reorder",
        "type": "object"
      },
      "ReplaceText": {
        "additionalProperties": false,
        "properties": {
          "op": {
            "const": "replace_text",
            "title": "Op",
            "type": "string"
          },

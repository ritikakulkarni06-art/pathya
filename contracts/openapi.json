            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "title": "With Block Id",
            "type": "string"
          }
        },
        "required": [
          "op",
          "with_block_id"
        ],
        "title": "Merge",
        "type": "object"
      },
      "Reorder": {
        "additionalProperties": false,

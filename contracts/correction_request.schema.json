{
  "$defs": {
    "MarkReviewed": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "mark_reviewed",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "MarkReviewed",
      "type": "object"
    },
    "Merge": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "merge",
          "title": "Op",
          "type": "string"
        },
        "with_base_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "With Base Revision"
        },
        "with_block_id": {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "title": "With Block Id",
          "type": "string"
        }
      },
      "required": [
        "op",
        "with_block_id"
      ],
      "title": "Merge",
      "type": "object"
    },
    "Reorder": {
      "additionalProperties": false,
      "properties": {
        "after_block_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Block Id"
        },
        "before_block_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Block Id"
        },
        "op": {
          "const": "reorder",
          "title": "Op",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        }
      },
      "required": [
        "op",
        "parent_id"
      ],
      "title": "Reorder",
      "type": "object"
    },
    "ReplaceText": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "replace_text",
          "title": "Op",
          "type": "string"
        },
        "text": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "op",
        "text"
      ],
      "title": "ReplaceText",
      "type": "object"
    },
    "SetAltText": {
      "additionalProperties": false,
      "properties": {
        "extended": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extended"
        },
        "op": {
          "const": "set_alt_text",
          "title": "Op",
          "type": "string"
        },
        "short": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Short",
          "type": "string"
        }
      },
      "required": [
        "op",
        "short"
      ],
      "title": "SetAltText",
      "type": "object"
    },
    "SetLanguage": {
      "additionalProperties": false,
      "properties": {
        "lang": {
          "enum": [
            "en",
            "hi"
          ],
          "title": "Lang",
          "type": "string"
        },
        "op": {
          "const": "set_language",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "lang"
      ],
      "title": "SetLanguage",
      "type": "object"
    },
    "SetMathML": {
      "additionalProperties": false,
      "properties": {
        "mathml": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Mathml",
          "type": "string"
        },
        "op": {
          "const": "set_mathml",
          "title": "Op",
          "type": "string"
        },
        "spoken_fallback": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Spoken Fallback",
          "type": "string"
        }
      },
      "required": [
        "op",
        "mathml",
        "spoken_fallback"
      ],
      "title": "SetMathML",
      "type": "object"
    },
    "SetTableHeaders": {
      "additionalProperties": false,
      "properties": {
        "header_cell_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Header Cell Ids",
          "type": "array"
        },
        "op": {
          "const": "set_table_headers",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "header_cell_ids"
      ],
      "title": "SetTableHeaders",
      "type": "object"
    },
    "SetType": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "set_type",
          "title": "Op",
          "type": "string"
        },
        "type": {
          "enum": [
            "heading",
            "paragraph",
            "list_item",
            "table",
            "table_cell",
            "equation",
            "figure",
            "caption"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "op",
        "type"
      ],
      "title": "SetType",
      "type": "object"
    },
    "Split": {
      "additionalProperties": false,
      "properties": {
        "at_offsets": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "At Offsets",
          "type": "array"
        },
        "op": {
          "const": "split",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op",
        "at_offsets"
      ],
      "title": "Split",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_revision": {
      "minimum": 1,
      "title": "Base Revision",
      "type": "integer"
    },
    "operations": {
      "items": {
        "discriminator": {
          "mapping": {
            "mark_reviewed": "#/$defs/MarkReviewed",
            "merge": "#/$defs/Merge",
            "reorder": "#/$defs/Reorder",
            "replace_text": "#/$defs/ReplaceText",
            "set_alt_text": "#/$defs/SetAltText",
            "set_language": "#/$defs/SetLanguage",
            "set_mathml": "#/$defs/SetMathML",
            "set_table_headers": "#/$defs/SetTableHeaders",
            "set_type": "#/$defs/SetType",
            "split": "#/$defs/Split"
          },
          "propertyName": "op"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ReplaceText"
          },
          {
            "$ref": "#/$defs/SetLanguage"
          },
          {
            "$ref": "#/$defs/SetType"
          },
          {
            "$ref": "#/$defs/Reorder"
          },
          {
            "$ref": "#/$defs/Split"
          },
          {
            "$ref": "#/$defs/Merge"
          },
          {
            "$ref": "#/$defs/MarkReviewed"
          },
          {
            "$ref": "#/$defs/SetAltText"
          },
          {
            "$ref": "#/$defs/SetMathML"
          },
          {
            "$ref": "#/$defs/SetTableHeaders"
          }
        ]
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "reason": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "base_revision",
    "operations",
    "reason"
  ],
  "title": "CorrectionRequest",
  "type": "object"
}
